[Unit]
Description=Personas: MinIO (the chat server's prekey store)
After=podman.socket
Wants=podman.socket

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=%h/.config/personas/env
# This VM's journal is admin-only (journalctl --user shows nothing), so log to a file.
StandardOutput=append:@WORK@/logs/personas-minio.log
StandardError=inherit
ExecStart=@REPO@/deploy/signal-test-server/minio.sh up
ExecStop=@REPO@/deploy/signal-test-server/minio.sh down

[Install]
WantedBy=default.target
