# Gateway on :8443 — what the UMIACS load balancer forwards to (public 443, TLS terminated
# upstream, plain HTTP to us). Supersedes plain-proxy.sh on the VM: same Signal routing,
# plus the browser-playable members under /play/.
{
	auto_https off
	admin off
}

:8443 {
	# --- browser-playable members -------------------------------------------------------
	# The whole /play tree is behind one shared password: anyone who reaches a member's
	# noVNC page IS that member, so this is the only thing standing between the public
	# internet and the demo accounts.
	# The same password guards the app download (/download/), so only invited testers get
	# it. The installed app itself never needs it.
	@play path /play /play/* /download /download/*
	basic_auth @play {
		{$PLAY_USER:demo} {$PLAY_PASSWORD_HASH}
	}

	# /play/<member>/... -> that member's noVNC (websockify also serves the web client).
	@member path_regexp member ^/play/(alice|bob|carol|dave|erin)/
	@storage path /v1/groups* /v2/groups* /v1/storage*

	# `route` keeps these in written order, so an unknown /play path 404s here instead
	# of falling through to the chat server.
	route {
		redir /play /play/
		handle /play/ {
			root * /srv/play
			rewrite * /index.html
			file_server
		}
		handle @member {
			uri strip_prefix /play/{re.member.1}
			reverse_proxy {re.member.1}:6080
		}
		handle /play/* {
			respond "no such member" 404
		}

		# --- tester guide + the installable app (download/) -----------------------------
		redir /download /download/
		handle_path /download/* {
			root * /srv/download
			header /*.dmg Content-Type application/x-apple-diskimage
			file_server {
				hide .*
			}
		}

		# --- member directory (directory.js): how clients find each other -----------
		# Not behind the /play password: installed clients call it. Writes are guarded
		# per entry by the secret its owner sent first.
		handle /personas/directory* {
			reverse_proxy directory:8080
		}

		# --- the canonical proving keys (keys.sh) ----------------------------------------
		# Public by nature (every member holds them). Clients verify the SHA-256 pinned in
		# their build, so this is a plain file download.
		handle /personas/keys/merkle_groth16_keys.bin {
			root * /srv/keys/params/serverless-merkle
			rewrite * /merkle_groth16_keys.bin
			file_server
		}
		handle /personas/keys/* {
			respond "not found" 404
		}

		# --- Signal backend (same routing as plain-proxy.sh / tls-proxy.sh) -------------
		handle @storage {
			reverse_proxy {$STORAGE_UPSTREAM:host.docker.internal:8090}
		}
		handle {
			reverse_proxy {$CHAT_UPSTREAM:host.docker.internal:8080}
		}
	}
}
